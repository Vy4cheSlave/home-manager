; rm -rf ~/.config/eww/ && cp -rf ~/nixos/conf/bar/eww ~/.config/eww && eww open bar --restart
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;						   Variable Section's							 ;;	
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;							Window Section's							 ;;	
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; bar window ;;
(defwindow bar
    :monitor 0 ;'[ "0", "<primary>" ]'
    :geometry (geometry 
        :x "0%"
        :y "0%"
        :width "100%"
        :height "4%"
        :anchor "top center"
    )
    :stacking "bottom"
    :exclusive true ; Если true :anchor должен включать в себя center
    (bar)
)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;							Widget Section's							 ;;	
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; bar widget ;;
(defwidget bar []
    (box
        :class "box_test"
        :orientation "h"
        (top)
        (mid)
        (bot)
    )
)

;; top widget ;;
(defwidget top []
    (box
        :class "box_test"
        :orientation "h"
        (workspaces)
        (box)
        (test_workspaces)
    )
)
;; mid widget ;;
(defwidget mid []
    (box
        :class "box_test"
        :orientation "h"
        (box :class "box_test")
        (clock)
        (box :class "box_test")
    )
)

;; bot widget ;;
(defwidget bot []
    (box
        :class "box_test"
        :orientation "h"
        (box
            (circular-progress 
                :thickness 4
                :value {EWW_BATTERY?.BAT0.capacity}
            )
            (label
            :class "text_test"
            :text "| 🌯: ${EWW_BATTERY?.BAT0.capacity} |"
        )
        )
    )
)

;; workspaces widget ;;
(defwidget workspaces []
	(box
        :class "box_test"
        :orientation "h"
        :space-evenly false
        :halign "start"
        (for entry in count_open_workspaces
            (box
                :class {entry.is_active ? "box_test" : ""}
                (label
                    :class "text_test"
                    :text {entry?.active_window_id != "null" ? entry.idx : "+"}
                )
            )
        )
    )
)
(defpoll count_open_workspaces 
    :initial "[]"
    :interval "250ms";
    `scripts/workspace.sh`
)

;; clock widget ;;
(defwidget clock []
	(box
        :class "box_test"
        :orientation "h"
        :space-evenly false
        :halign "center"
        (box
            ; :class "box_test"
            :halign "end"
            (label
                :class "text_test"
                :text clock_hour
            )
        )
        (box
            ; :class "box_test"
            :halign "center"
            :valign "center"
            (label
                :class "text_test"
                :text ":"
            )
        )
        (box
            ; :class "box_test"
            :halign "start"
            (label
                :class "text_test"
                :text clock_minute
            )
        )
    )
)
(defpoll clock_hour :interval "5s" "date +%H")
(defpoll clock_minute :interval "5s" "date +\%M")

;; test_workspaces ;;
(defwidget test_workspaces []
    (box
        :class "box_test"
        :orientation "h"
        ; {jq(test_listen, ".WorkspaceActivated.id") ? niri msg -j workspaces : niri msg -j workspaces}
        ; {jq(test_listen, '.WorkspaceActivated.id') != "null" ? 
        ;             (cmd "niri" "msg" "workspaces") : 
        ;             "niri msg -j workspaces"}
        {(test_listen.WorkspacesChanged)}
    )
)
(deflisten test_listen
    `niri msg -j event-stream`
    ; `niri msg -j event-stream | jq -c "
    ;      if .WorkspaceActivated then 
    ;          "$(niri msg -j workspaces | jq -c 'sort_by(.idx)')"
    ;      else 
    ;          empty 
    ;      end
    ;  " --argjson WORKSPACES "$(niri msg -j workspaces | jq -c 'sort_by(.idx)')"`
    ; `niri msg -j workspaces`
)












































































































; test ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defwidget bar_test []
    (centerbox
        :orientation "h"
        :class "outline"
        (box 
            :class "clock"
            "| 🌯: ${EWW_BATTERY?.BAT0.capacity} |"
        )
        (box
            :class "clock"
            ; :text "${formattime(EWW_TIME, "%H:%M")}"
            "${formattime(EWW_TIME, "%H:%M")}"
        )
        (box)
    )
)