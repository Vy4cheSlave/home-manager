; rm -rf ~/.config/eww/ && cp -rf ~/nixos/bar/eww ~/.config/eww && eww open bar --restart
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;						   Variable Section's							 ;;	
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;							Window Section's							 ;;	
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; bar window ;;
(defwindow bar
    :monitor 0 ;'[ "0", "<primary>" ]'
    :geometry (geometry 
        :x "0%"
        :y "0%"
        :width "100%"
        :height "4%"
        :anchor "top center"
    )
    :stacking "bottom"
    :exclusive true ; Если true :anchor должен включать в себя center
    (bar)
)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;							Widget Section's							 ;;	
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; bar widget ;;
(defwidget bar []
    (box
        :class "box_test"
        :orientation "h"
        (top)
        (mid)
        (bot)
    )
)

;; top widget ;;
(defwidget top []
    (box
        :class "box_test"
        :orientation "h"
        (workspaces)
    )
)
;; mid widget ;;
(defwidget mid []
    (box
        :class "box_test"
        :orientation "h"
        (clock)
    )
)

;; bot widget ;;
(defwidget bot []
    (box
        :class "box_test"
        :orientation "h"
        (box
            (circular-progress 
                :thickness 4
                :value {EWW_BATTERY?.BAT0.capacity}
            )
            (label
            ; :class "text_test"
            :text "| 🌯: ${EWW_BATTERY?.BAT0.capacity} |"
        )
        )
    )
)

;; workspaces widget ;;
(defwidget workspaces []
	(box
        :class "box_test"
        (box
            :class "box_test"
            ; used_workspace
            ; count_open_workspaces
            (workspace-monitor)
        )
    )
)
(defpoll count_open_workspaces 
    :initial "[]"
    :interval "250ms";"1s"
    ; ::run-while {current_workspace.WorkspaceActivated == null}
    ; "niri msg -j workspaces | jq -c 'sort_by(.idx)'"
    `scripts/workspace.sh`
)
(defwidget workspace-monitor []
    (box 
        (for entry in count_open_workspaces
            (box
                :class {entry.is_active ? "box_test" : ""}
                {entry.idx}
            )
        )
    )
)

; clock widget ;;
(defwidget clock []
	(box
        :class "box_test"
        :orientation "h"
        :spacing 0
        :space-evenly false
        :halign "center"
        (box
            ; :class "box_test"
            :halign "end"
            (label
                :class "text_test"
                :text clock_hour
            )
        )
        (box
            ; :class "box_test"
            :halign "center"
            :valign "center"
            (label
                :class "text_test"
                :text ":"
            )
        )
        (box
            ; :class "box_test"
            :halign "start"
            (label
                :class "text_test"
                :text clock_minute
            )
        )
    )
)
(defpoll clock_hour :interval "5s" "date +\%I")
(defpoll clock_minute :interval "5s" "date +\%M")


















































































































; test ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defwidget bar_test []
    (centerbox
        :orientation "h"
        :class "outline"
        (box 
            :class "clock"
            "| 🌯: ${EWW_BATTERY?.BAT0.capacity} |"
        )
        (box
            :class "clock"
            ; :text "${formattime(EWW_TIME, "%H:%M")}"
            "${formattime(EWW_TIME, "%H:%M")}"
        )
        (box)
    )
)